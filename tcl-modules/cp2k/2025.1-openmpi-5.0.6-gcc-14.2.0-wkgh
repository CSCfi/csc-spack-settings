module-whatis {CP2K is a quantum chemistry and solid state physics software package that can perform atomistic simulations of solid state, liquid, molecular, periodic, material, crystal, and biological systems }

proc ModulesHelp { } {
    puts stderr {Name   : cp2k}
    puts stderr {Version: 2025.1}
    puts stderr {Target : zen2}
    puts stderr {}
    puts stderr {CP2K is a quantum chemistry and solid state physics software package}
    puts stderr {that can perform atomistic simulations of solid state, liquid,}
    puts stderr {molecular, periodic, material, crystal, and biological systems}
}

